<Window x:Class="WaterCounters.Desktop.MasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaterCounters — мастер-пароль"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16">
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
      Мастер-пароль расшифровывает доступ к личному кабинету и пароль SMTP.
      Он вводится один раз на каждой машине и в Dropbox не попадает.
    </TextBlock>

    <PasswordBox x:Name="Password" Height="26" />

    <CheckBox x:Name="Remember"
              Content="Запомнить на этой машине (под DPAPI, для текущей учётной записи Windows)"
              IsChecked="True"
              Margin="0,12,0,0" />

    <TextBlock x:Name="Error" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Пропустить" Width="110" Margin="0,0,8,0" Click="OnSkip" />
      <Button Content="Продолжить" Width="110" IsDefault="True" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
