<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dropbox.Api" Version="7.2.0" />
  </ItemGroup>

  <!--
    Подстановка App key Dropbox в константу на этапе сборки. Значение приходит из
    dropbox.local.props или переменной окружения (см. Directory.Build.props) и
    в репозитории не хранится. Пустое значение допустимо: сборка проходит, а
    внятная ошибка возникает при первом обращении в рантайме.
  -->
  <!--
    Путь строится от BaseIntermediateOutputPath (obj\), а не от IntermediateOutputPath:
    последний ещё не определён на этапе вычисления свойств, и файл уехал бы в корень
    проекта — то есть под контроль версий, вместе с ключом. Плюс obj\ входит в
    DefaultItemExcludes, поэтому файл не попадает в glob **/*.cs дважды.
  -->
  <PropertyGroup>
    <GeneratedDropboxAppKeyFile>$(BaseIntermediateOutputPath)DropboxAppKey.g.cs</GeneratedDropboxAppKeyFile>
  </PropertyGroup>

  <Target Name="GenerateDropboxAppKey"
          BeforeTargets="BeforeCompile;CoreCompile"
          Inputs="$(MSBuildAllProjects)"
          Outputs="$(GeneratedDropboxAppKeyFile)">

    <PropertyGroup>
      <_DropboxAppKeySource><![CDATA[// <auto-generated /> Формируется целью GenerateDropboxAppKey. Не редактировать и не коммитить.
namespace WaterCounters.Core.Storage.Dropbox%3B

internal static class GeneratedDropboxAppKey
{
    public const string Value = "$(WaterCountersDropboxAppKey)"%3B
}
]]></_DropboxAppKeySource>
    </PropertyGroup>

    <WriteLinesToFile File="$(GeneratedDropboxAppKeyFile)"
                      Lines="$(_DropboxAppKeySource)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(GeneratedDropboxAppKeyFile)" />
      <FileWrites Include="$(GeneratedDropboxAppKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
