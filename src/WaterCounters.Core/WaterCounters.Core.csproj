<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dropbox.Api" Version="7.2.0" />
  </ItemGroup>

  <!--
    Подстановка App key Dropbox в константу на этапе сборки. Значение приходит из
    dropbox.local.props или переменной окружения (см. Directory.Build.props) и
    в репозитории не хранится. Пустое значение допустимо: сборка проходит, а
    внятная ошибка возникает при первом обращении в рантайме.
  -->
  <!--
    Путь строится от BaseIntermediateOutputPath (obj\), а не от IntermediateOutputPath:
    последний ещё не определён на этапе вычисления свойств, и файл уехал бы в корень
    проекта — то есть под контроль версий, вместе с ключом. Плюс obj\ входит в
    DefaultItemExcludes, поэтому файл не попадает в glob **/*.cs дважды.
  -->
  <PropertyGroup>
    <GeneratedDropboxAppKeyFile>$(BaseIntermediateOutputPath)DropboxAppKey.g.cs</GeneratedDropboxAppKeyFile>
  </PropertyGroup>

  <!--
    Без Inputs/Outputs намеренно. Инкрементальность по времени файлов здесь вредна:
    цель пропускалась бы при неизменных файлах проекта, и вместе с ней пропадали бы
    проверки ниже, а сгенерированная константа сохраняла бы прежний ключ даже после
    правки dropbox.local.props. Лишних пересборок не возникает: WriteLinesToFile
    с WriteOnlyWhenDifferent не трогает файл, когда содержимое совпадает.
  -->
  <Target Name="GenerateDropboxAppKey" BeforeTargets="BeforeCompile;CoreCompile">

    <PropertyGroup>
      <_DropboxAppKeySource><![CDATA[// <auto-generated /> Формируется целью GenerateDropboxAppKey. Не редактировать и не коммитить.
namespace WaterCounters.Core.Storage.Dropbox%3B

internal static class GeneratedDropboxAppKey
{
    public const string Value = "$(WaterCountersDropboxAppKey)"%3B
}
]]></_DropboxAppKeySource>
    </PropertyGroup>

    <!--
      Предупреждение, а не ошибка: собрать и прогнать тесты ядра можно и без ключа,
      он нужен только для реального обращения к Dropbox. Но молчать нельзя — иначе
      заглушка доезжает до Dropbox и возвращается как "Invalid client_id".
    -->
    <Warning Condition="'$(WaterCountersDropboxAppKey)' == ''"
             Text="App key Dropbox не задан. Скопируйте dropbox.local.props.example в dropbox.local.props или задайте WATERCOUNTERS_DROPBOX_APP_KEY. Обращения к Dropbox работать не будут." />

    <Warning Condition="'$(WaterCountersDropboxAppKey)' == 'PUT-YOUR-DROPBOX-APP-KEY-HERE'"
             Text="App key Dropbox остался заглушкой из dropbox.local.props.example. Подставьте свой ключ из https://www.dropbox.com/developers/apps." />

    <WriteLinesToFile File="$(GeneratedDropboxAppKeyFile)"
                      Lines="$(_DropboxAppKeySource)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(GeneratedDropboxAppKeyFile)" />
      <FileWrites Include="$(GeneratedDropboxAppKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
